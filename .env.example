# ── AFP Capital – Variables de entorno ──────────────────────────────────────
# Local:   cp .env.example .env  y completa los valores
# Railway: configura estas variables en el dashboard > Variables

# Credenciales AFP Capital (https://nueva-2.afpcapital.cl/)
AFP_RUT=12345678-9
AFP_PASSWORD=tu_contraseña_aqui

# Ruta a la base de datos SQLite
# Local:   dejar vacío (usa data.db en la raíz del proyecto)
# Railway: /data/data.db  (Railway Volume montado en /data)
DB_PATH=/data/data.db

# Secret para proteger los endpoints POST /scraper/run y POST /registros
# Genera uno con:  python3 -c "import secrets; print(secrets.token_hex(32))"
SCRAPER_SECRET=

# URL pública del servicio en Railway (para el scraper que corre en Mac)
# Obtén la URL en Railway dashboard > tu servicio > Settings > Domains
# Ejemplo: https://afp-production-xxxx.up.railway.app
RAILWAY_URL=

# Depuración del scraper (abre browser visible + screenshots) — solo local
# DEBUG_SCRAPER=true
